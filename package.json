    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.27.2",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.6.0"
  }
}
